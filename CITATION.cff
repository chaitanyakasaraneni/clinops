    given-names: Chaitanya
    orcid: "https://orcid.org/0000-0001-5792-1095"
    affiliation: "Independent Researcher, Chicago, Illinois, USA"
repository-code: "https://github.com/chaitanyakasaraneni/clinops"
url: "https://clinops.readthedocs.io"
license: Apache-2.0
version: 0.6.1
date-released: "2026-10-22"
keywords:
  - healthcare
  - clinical machine learning
  - electronic health records
  - MIMIC-IV
  - eICU
  - FHIR
  - data preprocessing
  - time series
